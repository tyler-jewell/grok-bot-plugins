{
  "name": "grok-bot-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "node scripts/embed-skills.mjs --check && wrangler types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist --var GIT_SHA:${GITHUB_SHA:-local}",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "test:a11y": "playwright test",
    "test:watch": "vitest",
    "embed-skills": "node scripts/embed-skills.mjs --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "agents": "^0.33.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true,
    "core-js-pure@3.51.0": true
  }
}
